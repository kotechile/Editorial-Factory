# Frontier rewrite — OpenRouter, GLM, or DeepSeek
# Option A: OpenRouter (recommended for GLM 5.3, Claude 3.5 Sonnet, GPT-4o, etc.)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=z-hipu/glm-4-plus
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Option B: Direct GLM / Zhipu BigModel
# GLM_API_KEY=
# GLM_MODEL=glm-4-plus

# Option C: Direct DeepSeek
DEEPSEEK_API_KEY=
# FRONTIER_MODEL=deepseek-v4-pro

# Frontier provider override: openrouter | glm | deepseek
# FRONTIER_PROVIDER=openrouter 

# Access control (REQUIRED in any deployed instance)
# The dashboard reads/writes the editorial working tree and can shell out to
# scripts that spend real API money. Everything except /published/*,
# /api/articles.json and /healthz requires this secret (HTTP Basic with any
# username, `Authorization: Bearer <secret>`, `x-editorial-key`, or the
# `pressflow_auth` cookie). If it is unset the site fails closed with 503.
PRESSFLOW_AUTH_SECRET=

# Persistence (Supabase: drafts, signals, published log)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Publisher (persistence only — the LinkedIn/Reddit distribution channel was removed 2026-10-06)
#                     Set to "false" / "0" (default) for copy-paste review mode.

# Optional Ghost / PressFlow CMS targets
GHOST_ADMIN_API_KEY=
GHOST_API_URL=

# Optional Link Ingestion Defaults (used by scripts/publish.py)
# DEFAULT_ARTICLE_BASE_URL=https://pressflow.aichieve.net/articles   # auto-appends /<slug>
# DEFAULT_PROMO_URL=https://factory.aichieve.net/tools/scanner        # cross-promotes software factory tool
# DEFAULT_PROMO_LABEL="🛠️ Try the live tool:"

# Google Search Console API (SEO Content Machine)
# GSC_PROPERTY_URL=sc-domain:editorialfactory.io
# GSC_CREDENTIALS_JSON=/path/to/service-account.json

# DataForSEO API / MCP (Keyword Metrics & SERP Landscape)
# DATAFORSEO_LOGIN=your_login_email@example.com
# DATAFORSEO_PASSWORD=your_api_password
# DATAFORSEO_API_KEY=your_api_key_or_token

# Supply Chain & IT Intelligence MCP / REST (Coolify-hosted)
# SUPPLY_CHAIN_INTEL_URL=https://intel.giniloh.com

# Featured images (scripts/illustration_creator.py)
# kie.ai gateway: the art director's brief runs on DEEPSEEK_API_KEY (frontier_llm, deepseek-v4-pro;
# the render reviewer uses deepseek-flash) and the image
# models run on kie.ai (flux-2/pro-text-to-image, nano-banana-pro). The KIE key is the same one the
# stylist profile holds as ANTHROPIC_API_KEY=Bearer <kie key>; an Anthropic direct key
# (sk-ant-…) authenticates the Claude API but NOT api.kie.ai.
KIE_API_KEY=
# ILLUSTRATION_ENABLED=false disables the featured-image pass entirely (publish.py + the sweep).

# Home & Lifestyle Intelligence MCP / REST (Coolify-hosted)
# HOME_LIFESTYLE_INTEL_URL=https://lifestyle.giniloh.com
