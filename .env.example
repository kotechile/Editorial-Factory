# Frontier rewrite — Claude via kie.ai (NOT api.anthropic.com)
# Value MUST include the literal "Bearer " prefix:  Bearer <kie.ai key>
# Model IDs: claude-sonnet-5 (default, resolves to claude-opus-4-5-20251101), Claude-Opus-4-8
# Routing: set model.base_url=https://api.kie.ai/claude on the stylist profile
ANTHROPIC_API_KEY=Bearer 

# Persistence (Supabase: drafts, signals, published log)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Publisher (persistence + multi-channel distribution)
# LINKEDIN_AUTO_POST: Set to "true" / "1" to automatically post to LinkedIn via API.
#                     Set to "false" / "0" (default) for copy-paste review mode.
LINKEDIN_AUTO_POST=false
LINKEDIN_ACCESS_TOKEN=

# Optional Ghost / PressFlow CMS targets
GHOST_ADMIN_API_KEY=
GHOST_API_URL=

# Optional Link Ingestion Defaults (used by scripts/publish.py)
# DEFAULT_ARTICLE_BASE_URL=https://pressflow.aichieve.net/articles   # auto-appends /<slug>
# DEFAULT_PROMO_URL=https://factory.aichieve.net/tools/scanner        # cross-promotes software factory tool
# DEFAULT_PROMO_LABEL="🛠️ Try the live tool:"

# Google Search Console API (SEO Content Machine)
# GSC_PROPERTY_URL=sc-domain:editorialfactory.io
# GSC_CREDENTIALS_JSON=/path/to/service-account.json

# DataForSEO API / MCP (Keyword Metrics & SERP Landscape)
# DATAFORSEO_LOGIN=your_login_email@example.com
# DATAFORSEO_PASSWORD=your_api_password
# DATAFORSEO_API_KEY=your_api_key_or_token


