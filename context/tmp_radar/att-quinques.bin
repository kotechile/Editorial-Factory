<script type="application/javascript">
					

						init_accordion_aperto();
						carica_accordion();
						carica_accordion2();
					
						const queryParams = new URLSearchParams(window.location.search);
						if (queryParams.has('ancora')) {
							set_open(queryParams.get('ancora'));
						}
					
						function init_accordion_aperto() {
							var elementi_lista = document.getElementsByClassName("schedaPDL")[0].children;
							for ( var l=0; l<elementi_lista.length; l++) {
								if ( elementi_lista[l].classList.contains('show') ) {
									elementi_lista[l-1].children[0].classList.add('opened');
								}
							}
						}
					
						function carica_accordion() {
							var acc = document.getElementsByClassName("btn-block");
							for (var i=0; i<acc.length; i++) {
								acc[i].addEventListener("click", function(event) {
									var panel = this.parentElement.nextElementSibling;
									var blocchi = document.getElementsByClassName("collapse");
									for (var b=0; b<blocchi.length; b++) {
										if (panel.getAttribute('id') == blocchi[b].getAttribute('id')) {
											blocchi[b].classList.toggle("show");
											event.target.classList.toggle('opened');
										}
									}
								});
							}
						}
					
						function carica_accordion2() {
							var acc = document.getElementsByClassName("btn-link");
							for (var i=0; i<acc.length; i++) {
								acc[i].addEventListener("click", function(event) {
									var panel = this.parentElement.parentElement.nextElementSibling;
									var blocchi = document.getElementsByClassName("collapse");
									for (var b=0; b<blocchi.length; b++) {
										if (panel.getAttribute('id') == blocchi[b].getAttribute('id')) {
											blocchi[b].classList.toggle("show");
											event.target.classList.toggle('opened');
										}
									}
								});
							}
						}
					
						function set_open(ancora){
							const macroSezione = ancora.substring(0, ancora.indexOf("."));
							const microSezione = ancora.substring(ancora.indexOf(".") + 1);
							if (document.querySelector("button[data-target='#" + macroSezione + "']") && document.querySelector("button[data-target='#" + microSezione + "']")) {
								// Apre gli accordion passati
								document.querySelector("button[data-target='#" + macroSezione + "']").click();
								document.querySelector("button[data-target='#" + microSezione + "']").click();
								// Chiude l'accordion "Iter"
								document.querySelector("button[data-target='#datiGenerali']").click();
							}
						}

						function copiaLink(link, ancora) {
							this.event.stopPropagation();
							const idSpan = ancora.replace('.sede', '.');
							const linkAncora = link + ancora;
							navigator.clipboard.writeText(linkAncora);
							document.getElementById(idSpan).setAttribute('title', 'Link copiato negli appunti!');		
							setTimeout(function() { document.getElementById(idSpan).setAttribute('title', 'Clicca per copiare il link a questa sezione'); }, 5000);
						}
						
						
				
				</script>

