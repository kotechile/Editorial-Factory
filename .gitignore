# deps / build
node_modules/
.next/
dist/
*.tsbuildinfo
__pycache__/
*.pyc


# env / secrets — never commit real values
.env
.env.local
*service_account*.json
context/gsc_service_account.json

# local runtime artifacts
*.log
.publish_cache/
test-results/
playwright-report/
.*_backup*

# generated featured images: the CMS media library is their canonical home and the staged file is
# only the upload's source. The brief beside each image (featured.json) IS committed — it is the
# provenance record (prompt, model, task id, credits, alt/caption) and the anti-repeat history.
context/assets/illustrations/**/*.jpg
context/assets/illustrations/**/*.jpeg
context/assets/illustrations/**/*.png
context/assets/illustrations/**/*.webp
context/assets/_review_*

# OS
.DS_Store

# local rollback snapshot of superseded editorial files
context/_archive_not_latest/
